# Copy this file to .env before running Docker Compose.
# Never commit real secrets.

POSTGRES_DB=SmartDoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

SMARTDOC_PORT=8087
AISMARTDOC_PORT=8088
SMARTDOC_AI_PORT=8000
FRONTEND_PORT=4200

SERVICE_TOKEN=change-me-shared-service-token
APP_JWT_SECRET=change-me-to-a-long-random-secret
PAYMENT_STRIPE_SECRET_KEY=
GEMINI_API_KEY=
MODEL_NAME=gemini-3.1
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5

KAFKA_PORT=9092
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_KAFKA_AUDIT_TOPIC=smartdoc.audit.events
APP_KAFKA_CLIENT_ID=smartdoc

# Optional: point SmartDoc to a Kafka broker if you want audit events in Docker.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

