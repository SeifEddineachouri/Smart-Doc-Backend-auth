# SmartDoc CI/CD Pipeline Environment Configuration

# Jenkins Configuration
JENKINS_JAVA_OPTS=-Xmx2048m -XX:+UseG1GC
JENKINS_OPTS=-Djenkins.install.runSetupWizard=false
CASC_JENKINS_CONFIG=/var/jenkins_home/casc_configs

# Docker Configuration
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# PostgreSQL Configuration
POSTGRES_DB=smartdoc
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SonarQube Configuration
SONAR_DB_USER=smartdoc
SONAR_DB_PASSWORD=smartdoc123
SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/smartdoc
SONAR_ES_BOOTSTRAP_CHECKS_DISABLED=true

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
ZOOKEEPER_CLIENT_PORT=2181

# Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=smartdoc-backend-auth

# Kubernetes Configuration
KUBE_NAMESPACE=smartdoc-dev
APP_NAME=smartdoc-backend

# CI/CD Configuration
CI_ENABLED=true
AUTO_DEPLOY=false
